# Clave de API de Groq para la función Edge de validación con IA (Track 3).
# Groq es gratis y no requiere tarjeta: crea la clave en https://console.groq.com/keys
# En Vercel se configura en Project Settings → Environment Variables (no en este archivo).
# Localmente, para probar la función con `vercel dev`, copia este archivo a .env.local.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
